<Window x:Class="V2Dex.WindowsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V2Dex"
        Width="520"
        Height="900"
        MinWidth="460"
        MinHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#030511" Offset="0" />
            <GradientStop Color="#0A0D25" Offset="0.42" />
            <GradientStop Color="#050612" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2EFFFFFF" Offset="0" />
            <GradientStop Color="#141A3B" Offset="0.48" />
            <GradientStop Color="#2B1D4B" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SelectedGlassFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3FFFFFFF" Offset="0" />
            <GradientStop Color="#1A2556" Offset="0.44" />
            <GradientStop Color="#50319B" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopSheen" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#40FFFFFF" Offset="0" />
            <GradientStop Color="#10FFFFFF" Offset="0.44" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DockFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#33FFFFFF" Offset="0" />
            <GradientStop Color="#12162F" Offset="0.48" />
            <GradientStop Color="#21113C" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PowerFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6E63FF" Offset="0" />
            <GradientStop Color="#4B22B8" Offset="0.55" />
            <GradientStop Color="#130B2D" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="LatencyGood" Color="#67F6A6" />
        <SolidColorBrush x:Key="LatencyWarn" Color="#FFB15C" />
        <SolidColorBrush x:Key="Accent" Color="#9C8BFF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#6F55F2" />

        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="17" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="#7A5CFF" BlurRadius="13" ShadowDepth="0" Opacity="0.35" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#252844" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="17"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Ellipse Width="26"
                                         Height="26"
                                         Fill="{StaticResource GlassFill}"
                                         HorizontalAlignment="Left"
                                         Margin="4,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#7A5CFF" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,0,0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigRowCard" TargetType="Border">
            <Setter Property="Height" Value="58" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="6" Opacity="0.22" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedGlassFill}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#7A5CFF" BlurRadius="15" ShadowDepth="0" Opacity="0.34" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="30"
            Background="{StaticResource AppBackground}"
            MouseLeftButtonDown="WindowDragMouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="18" Opacity="0.45" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Ellipse Width="430"
                     Height="430"
                     Fill="#332E1F80"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-160,-130">
                <Ellipse.Effect>
                    <BlurEffect Radius="48" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="300"
                     Height="260"
                     Fill="#242673FF"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-120,-80,0,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="46" />
                </Ellipse.Effect>
            </Ellipse>
            <Border CornerRadius="30"
                    Background="#26000000"
                    Margin="12" />

            <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="124" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,8,8,24">
                <StackPanel>
                    <TextBlock Text="{Binding HeaderTitle}"
                               Foreground="White"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="31"
                               FontWeight="Black"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusLine}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="14"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource HeaderIconButton}"
                            Content="◎"
                            FontSize="20"
                            Margin="0,0,8,0"
                            Click="ConnectionClick" />
                    <Button Style="{StaticResource HeaderIconButton}"
                            Content="+"
                            FontSize="28"
                            Click="ImportClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0,12,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⌃"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Black"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,1" />
                        <TextBlock Text="Saved Configs"
                                   Foreground="White"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="21"
                                   FontWeight="Black"
                                   VerticalAlignment="Center" />
                        <Border Width="26"
                                Height="26"
                                CornerRadius="13"
                                Background="#5232A8"
                                Margin="10,0,0,0">
                            <TextBlock Text="{Binding Profiles.Count}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="Black"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <Button Style="{StaticResource GlassButton}"
                            Content="◉"
                            HorizontalAlignment="Right"
                            Click="PingAllClick" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding ActiveProfile, Mode=TwoWay}"
                         SelectionChanged="ProfileSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ConfigRowCard}">
                                <Grid>
                                    <Rectangle Width="120"
                                               Height="34"
                                               RadiusX="16"
                                               RadiusY="16"
                                               Fill="{StaticResource TopSheen}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Opacity="0.45" />
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding FlagText}"
                                               FontSize="27"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="Black"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Endpoint}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   FontFamily="Consolas"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding LatencyText}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="14"
                                               FontWeight="Black"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="-4,0,-4,2">
                <Border Height="72"
                        CornerRadius="36"
                        Background="{StaticResource DockFill}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#6D49FF" BlurRadius="22" ShadowDepth="0" Opacity="0.28" />
                    </Border.Effect>
                    <Grid Margin="24,0">
                        <Rectangle Height="1"
                                   Fill="#22FFFFFF"
                                   VerticalAlignment="Top"
                                   Margin="24,5,24,0" />
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="126" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton Grid.Column="0"
                                      x:Name="RouterToggle"
                                      Style="{StaticResource DockToggle}"
                                      Width="66"
                                      Height="34"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Content="◎"
                                      Click="RouterToggleClick" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="⌁"
                                       Foreground="{StaticResource Accent}"
                                       FontSize="28"
                                       FontWeight="Black"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding LastPingText}"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Black"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Ellipse Width="100"
                         Height="100"
                         Fill="#22000000"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,-9,0,0">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="8" Opacity="0.38" />
                    </Ellipse.Effect>
                </Ellipse>

                <Button Width="82"
                        Height="82"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,0,0,0"
                        Background="{StaticResource PowerFill}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="38"
                        FontWeight="Black"
                        Content="{Binding PowerText}"
                        Cursor="Hand"
                        Click="PowerClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="41" Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7A5CFF" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
